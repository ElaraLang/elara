    location: https://github.com/ElaraLang/diagnose
    tag: d86419d886012e87f12fd46ce40b6f1f6c458c8f
    --sha256: sha256-Y9D5HpE+LNGimu8ZKlyhV/N1l6hwWXhZKmfQtQSjjT8=

source-repository-package
