packages: elara.cabal
package *
    profiling: False
    profiling-detail: late

source-repository-package
    type: git
    location: https://github.com/ElaraLang/h2jvm

source-repository-package
    type: git
    location: https://github.com/ElaraLang/dependent-hashmap

source-repository-package
    type: git
    location: https://github.com/ElaraLang/diagnose

package diagnose
    flags: +megaparsec-compat

package elara
    haddock-options: --source-module="https://github.com/ElaraLang/elara/tree/main/%F" --source-entity="https://github.com/ElaraLang/elara/tree/main/%F#L%L"
