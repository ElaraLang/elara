    --sha256: sha256-n5LhwJUZn4NZDmV3W1FMsp/vmuDQrhbVy/WPx+3Dbvs=
    subdir: safe-coloured-text-terminfo

package elara
    haddock-options: --source-module="https://github.com/ElaraLang/elara/tree/main/%F" --source-entity="https://github.com/ElaraLang/elara/tree/main/%F#L%L"
    optimization: False
    ghc-options: -fdefer-typed-holes -fwrite-ide-info -hiedir=.hie

-- the hackage snapshot to solve dependencies against
-- bump it to upgrade dependencies, with `just bump-index-state`
-- DO NOT REMOVE! haskell.nix starts doing very strange things without this, including trying to build nix from source!!!!
index-state: 2026-11-21T00:00:00Z

if arch(wasm32)
  -- Template Haskell on wasm loads dependencies as shared libraries
  package *
    shared: True
