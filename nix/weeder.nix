# Unused code report, generated by running weeder.
# We don't want this to be a check because then `nix flake check` would fail on unused code, which would be quite annoying
# weeder-nix's only works on x86-64 linux
{ weeder-nix }:
hixPkgs:
(import "${weeder-nix}/nix/overlay.nix" (
  hixPkgs // { haskellPackages = hixPkgs.haskell.packages.ghc912; } # use our ghc version
) null).weeder-nix.makeWeederCheck
  {
    name = "weeder-report";
    reportOnly = true;
    weederToml = ../weeder.toml;
    haskellPackages = hixPkgs.__hix.packages; # hix's set, which contains elara
    packages = [ "elara" ];
  }
